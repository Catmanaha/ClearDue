# Copy to .env. Never paste secrets into chat or commit this file's configured copy.
APP_URL=http://127.0.0.1:3000
DATABASE_URL=postgresql://cleardue:cleardue_local@127.0.0.1:5432/cleardue
TEST_DATABASE_URL=postgresql://cleardue:cleardue_local@127.0.0.1:5432/cleardue_test
ALLOW_TEST_DATABASE_RESET=false
PAYMENT_MODE=demo
AI_MODE=fixture
AI_PROVIDER=openai
# Loopback demo bypass only; never available with sandbox or non-loopback APP_URL.
LOCAL_DEMO_ACCESS=true
BETTER_AUTH_SECRET=
OWNER_EMAILS=
READ_ONLY_JUDGE_EMAIL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_SELLER_EMAIL=
PAYPAL_BUYER_EMAIL=
PAYPAL_WEBHOOK_ID=
PAYPAL_SANDBOX_TEST_ENABLED=false
PAYPAL_SANDBOX_WRITE_ENABLED=false
# After guarded creation, explicitly add only this project's tagged invoice IDs.
PAYPAL_PROJECT_INVOICE_IDS=
PAYPAL_CONTRACT_STAGE=read
PAYPAL_CONTRACT_INVOICE_ID=
PAYPAL_CONTRACT_APPROVE_CORRECTION=false
# Private CLI setup only; remove password from environment after provisioning.
CLEARDUE_OWNER_ID=
CLEARDUE_OWNER_EMAIL=
CLEARDUE_OWNER_PASSWORD=
RESET_DEMO_DATA=false
OPENAI_API_KEY=
OPENAI_MODEL=
ASTRO_GATEWAY_URL=https://aig.astropods.ai
ASTRO_GATEWAY_API_KEY=
ASTRO_GATEWAY_MODEL=
ASTROPODS_CREDIT_ONLY_CONFIRMED=false
LIVE_AI_ENABLED=false
# User chooses actual bounds; blank disables live requests. Reservations persisted per UTC date.
LIVE_AI_DAILY_CALL_LIMIT=
LIVE_AI_DAILY_TOKEN_LIMIT=
LIVE_AI_MAX_OUTPUT_TOKENS=
# AG client license may be visible in browser as required by vendor; never commit material.
AG_STUDIO_LICENSE_KEY=
AG_STUDIO_ENABLED=false
