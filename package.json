{
  "name": "cleardue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0 <23 || >=24 <25"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "worker": "tsx --env-file-if-exists=.env scripts/worker.ts",
    "ai:gateway:import": "tsx scripts/import-astropods.ts",
    "setup:check": "tsx --env-file-if-exists=.env scripts/check-setup.ts",
    "webhook:gateway": "tsx --env-file-if-exists=.env scripts/webhook-gateway.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "db:owner": "tsx --env-file-if-exists=.env scripts/owner.ts",
    "db:reset:demo": "tsx --env-file-if-exists=.env scripts/reset-demo.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:paypal": "tsx --env-file-if-exists=.env scripts/paypal-contract.ts",
    "eval:fixtures": "tsx scripts/evaluate.ts",
    "eval:live": "tsx --env-file-if-exists=.env scripts/evaluate-live.ts",
    "eval:fresh": "tsx --env-file-if-exists=.env scripts/evaluate-fresh.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm eval:fixtures && pnpm build",
    "verify:local": "pnpm verify && pnpm test:integration && pnpm test:e2e",
    "test:e2e:production": "pnpm build && playwright test --config playwright.production.config.ts"
  },
  "dependencies": {
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "ag-studio": "3.0.0",
    "ag-studio-react": "3.0.0",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.64.0",
    "next": "16.4.3",
    "openai": "7.45.1",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.18.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
